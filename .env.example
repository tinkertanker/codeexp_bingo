# Convex deployment URL — printed by `npx convex dev` after first run.
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud

# Shared mentor/admin passcode. Anyone with this can act as a mentor in /admin.
# Also set the same value on the Convex deployment with:
#   npx convex env set ADMIN_PASSCODE 'change-me'
VITE_ADMIN_PASSCODE=change-me

# Comma-separated names allowed to flip game state and run the lucky draw.
# Match what's on the Convex deployment:
#   npx convex env set ORGANISER_NAMES 'YJ,Marcus'
VITE_ORGANISER_NAMES=YJ,Marcus
